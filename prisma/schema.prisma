// PaySynk multi-tenant ecommerce schema
// Designed so online + POS can share products / stock / orders later.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PaymentProviderType {
  stripe
  paypal
  fac
}

enum OrderChannel {
  online
  pos
}

enum OrderStatus {
  pending
  paid
  fulfilled
  cancelled
  refunded
}

enum ProductKind {
  tee
  tote
  other
}

enum SignupStatus {
  pending
  approved
  rejected
}

enum OfferKind {
  code
  bundle
  gift
}

enum DiscountKind {
  percent
  amount
}

enum GiftMode {
  per_item
  per_order
}

enum SalesReportFrequency {
  none
  daily
  weekly
  monthly
}

enum ModifierKind {
  none
  amount
  percent
}

model Store {
  id                String              @id @default(cuid())
  slug              String              @unique
  name              String
  currency          String              @default("gbp")
  /// ISO country for domestic delivery (GB, JM, …).
  homeCountry       String              @default("GB")
  /// Flat domestic shipping in minor units (e.g. 525 = £5.25)
  shippingFlatMinor Int                 @default(525)
  /// International shipping in minor units. Null = not offered.
  shippingIntlMinor Int?
  paymentProvider   PaymentProviderType @default(stripe)
  /// Admin notes for Stripe wiring (keys stay in env / Connect — never exposed to client)
  stripeConfigNotes String?
  stripeConnectId   String?
  paypalMerchantId  String?
  paymentsActive    Boolean             @default(false)
  signupStatus      SignupStatus        @default(pending)
  adminNotes        String?
  /// Public shop logo (Blob or /uploads/…). Shown on the storefront and success page.
  logoUrl           String?
  /// light | dark — product widgets and cart on the merchant’s own website.
  embedTheme        String              @default("light")
  /// Shown on customer receipts (UK VAT / EU VAT ID).
  vatNumber         String?
  /// Order alerts and sales reports. Falls back to the owner login email.
  notifyEmail       String?
  salesReportFrequency SalesReportFrequency @default(none)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  products       Product[]
  configProducts ConfigProduct[]
  orders         Order[]
  users          MerchantUser[]
  offers         Offer[]

  @@index([signupStatus])
}

model MerchantUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
}

model Product {
  id          String      @id @default(cuid())
  storeId     String
  store       Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title       String
  description String      @default("")
  images      String[]
  active      Boolean     @default(true)
  kind        ProductKind @default(other)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  variants Variant[]

  @@index([storeId])
}

model Variant {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// e.g. { "colour": "Red", "size": "M" }
  options    Json
  sku        String
  priceMinor Int
  stockQty   Int     @default(0)
  imageUrl   String?

  orderItems OrderItem[]

  @@unique([productId, sku])
  @@index([productId])
}

model Order {
  id                String              @id @default(cuid())
  storeId           String
  store             Store               @relation(fields: [storeId], references: [id])
  status            OrderStatus         @default(pending)
  channel           OrderChannel        @default(online)
  paymentProvider   PaymentProviderType
  /// Stripe Checkout Session id (or future FAC reference)
  providerPaymentId String?
  currency          String
  subtotalMinor     Int
  shippingMinor     Int
  totalMinor        Int
  discountMinor     Int                 @default(0)
  discountCode      String?
  customerEmail     String?
  customerName      String?
  customerPhone     String?
  /// UK delivery details collected in the cart before Stripe.
  shippingAddress   Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  items OrderItem[]

  @@unique([paymentProvider, providerPaymentId])
  @@index([storeId])
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId       String?
  variant         Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  title           String
  optionsSnapshot Json
  sku             String
  unitPriceMinor  Int
  quantity        Int
  lineTotalMinor  Int

  @@index([orderId])
}

/// Store-scoped promo: typed codes, buy-X-with-Y bundles, or a free gift.
model Offer {
  id               String         @id @default(cuid())
  storeId          String
  store            Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  kind             OfferKind
  title            String
  active           Boolean        @default(true)

  /// Promo code (stored uppercase). Unique per store when set.
  code             String?
  discountKind     DiscountKind?
  /// Percent 1–100, or amount in minor units (pence)
  discountValue    Int?
  minSubtotalMinor Int?

  /// Bundle: one of product A + one of product B → bundleOffMinor off per pair
  productIdA       String?
  productIdB       String?
  bundleOffMinor   Int?

  /// Gift: add giftProduct at £0. per_item = one per paid item; per_order = one per checkout
  giftProductId    String?
  giftMode         GiftMode?

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([storeId, active])
  @@index([storeId, kind])
}

/// Platform copy-on-add library (Business Cards, Brochures, …). Not sold directly.
model ConfigTemplate {
  id                   String  @id @default(cuid())
  slug                 String  @unique
  title                String
  category             String  @default("")
  description          String  @default("")
  sku                  String  @default("")
  basePriceMinor       Int     @default(0)
  uploadsEnabled       Boolean @default(true)
  instructionsEnabled  Boolean @default(false)
  /// { options: [{ name, required, values: [{ label, modifierKind, modifierValue }] }], variations: [{ matchLabels: { OptionName: "Value"| "*" }, priceMinor, sku }] }
  definition           Json
  sort                 Int     @default(0)
}

/// Store-owned Ecwid-style product: dropdowns, combo prices, file upload.
model ConfigProduct {
  id                   String   @id @default(cuid())
  storeId              String
  store                Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  slug                 String
  title                String
  sku                  String   @default("")
  description          String   @default("")
  images               String[]
  category             String   @default("")
  active               Boolean  @default(true)
  basePriceMinor       Int      @default(0)
  uploadsEnabled       Boolean  @default(true)
  instructionsEnabled  Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  options    ConfigOption[]
  variations ConfigVariation[]
  relatedFrom ConfigRelated[] @relation("RelatedFrom")
  relatedTo   ConfigRelated[] @relation("RelatedTo")

  @@unique([storeId, slug])
  @@index([storeId, active])
}

model ConfigOption {
  id        String  @id @default(cuid())
  productId String
  product   ConfigProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  required  Boolean @default(true)
  sort      Int     @default(0)
  values    ConfigOptionValue[]

  @@index([productId])
}

model ConfigOptionValue {
  id            String       @id @default(cuid())
  optionId      String
  option        ConfigOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  label         String
  sort          Int          @default(0)
  modifierKind  ModifierKind @default(none)
  /// Amount in minor units, or percent (e.g. 15 = +15%).
  modifierValue Int          @default(0)

  @@index([optionId])
}

model ConfigVariation {
  id         String @id @default(cuid())
  productId  String
  product    ConfigProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// { [optionId]: valueId | "*" }
  match      Json
  priceMinor Int
  sku        String @default("")
  sort       Int    @default(0)

  @@index([productId])
}

model ConfigRelated {
  fromProductId String
  toProductId   String
  from          ConfigProduct @relation("RelatedFrom", fields: [fromProductId], references: [id], onDelete: Cascade)
  to            ConfigProduct @relation("RelatedTo", fields: [toProductId], references: [id], onDelete: Cascade)
  sort          Int           @default(0)

  @@id([fromProductId, toProductId])
}
