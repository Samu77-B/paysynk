# App
# Must include the scheme. Production: https://www.paysynk.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon Postgres (storefront + merchant sign-up / dashboard)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Stripe Checkout (storefront) + Connect (merchant payouts)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# From Stripe Dashboard → Connect settings. Redirect URI:
# https://www.paysynk.com/api/connect/stripe/callback
STRIPE_CONNECT_CLIENT_ID=ca_...

# PayPal seller onboarding + checkout (optional). Sandbox unless PAYPAL_ENV=live.
# Return URL: https://www.paysynk.com/api/connect/paypal/callback
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_BN_CODE=

# Auth.js (merchant /login + /admin/login)
AUTH_SECRET=generate-a-long-random-string
AUTH_URL=http://localhost:3000

# SmartSynk master admin API (server-to-server). Send as: Authorization: Bearer <key>
SMARTSYNK_API_KEY=generate-a-long-random-string

# Product photos: local saves go to public/uploads (gitignored).
# On Vercel, create a Blob store so BLOB_READ_WRITE_TOKEN is set automatically.
# BLOB_READ_WRITE_TOKEN=

# Shop emails (customer confirmation + merchant order alert + sales reports)
# Verify the from-domain in Resend. Until then, test sends often only reach the Resend account owner.
RESEND_API_KEY=re_...
RESEND_FROM=PaySynk <noreply@paysynk.com>

# Protects GET /api/cron/sales-reports (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=generate-a-long-random-string
