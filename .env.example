# App
# Must include the scheme. Production: https://www.paysynk.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon Postgres (storefront + merchant sign-up / dashboard)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Stripe Checkout (storefront) + Connect (merchant payouts)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_CLIENT_ID=

# Auth.js (merchant /login + /admin/login)
AUTH_SECRET=generate-a-long-random-string
AUTH_URL=http://localhost:3000

# SmartSynk master admin API (server-to-server). Send as: Authorization: Bearer <key>
SMARTSYNK_API_KEY=generate-a-long-random-string

# Product photos: local saves go to public/uploads (gitignored).
# On Vercel, create a Blob store so BLOB_READ_WRITE_TOKEN is set automatically.
# BLOB_READ_WRITE_TOKEN=
