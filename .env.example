# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon Postgres (storefront + merchant sign-up / dashboard)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Stripe Checkout (storefront) + Connect (merchant payouts)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_CLIENT_ID=

# Auth.js (merchant /login + /admin/login)
AUTH_SECRET=generate-a-long-random-string
AUTH_URL=http://localhost:3000

# SmartSynk master admin API (server-to-server). Send as: Authorization: Bearer <key>
SMARTSYNK_API_KEY=generate-a-long-random-string

# Product photos save to public/uploads locally (gitignored).
# On Vercel those files do not persist — add Blob storage before going live with uploads.
