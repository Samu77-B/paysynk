# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (merchant dashboard auth + RLS Postgres)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional service role for webhooks / admin jobs only (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# Legacy Prisma storefront DB (hosted /s/:slug + Stripe checkout MVP)
# Can point at the same Supabase Postgres connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require

# Stripe Checkout (storefront) + Connect (merchant payouts)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_CLIENT_ID=

# Auth.js (legacy /admin routes — dashboard uses Supabase Auth)
AUTH_SECRET=generate-a-long-random-string
AUTH_URL=http://localhost:3000
