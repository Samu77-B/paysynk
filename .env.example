# Postgres (Neon, Prisma Postgres, local Docker, etc.)
# Must be a standard TCP URL for Prisma 7 + @prisma/adapter-pg:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
DATABASE_URL=

# App URL (no trailing slash) — used for Stripe success/cancel redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (server only — never NEXT_PUBLIC_)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Auth.js / NextAuth
AUTH_SECRET=generate-a-long-random-string
# Optional if AUTH_URL differs from NEXT_PUBLIC_APP_URL
AUTH_URL=http://localhost:3000
