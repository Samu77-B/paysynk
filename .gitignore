# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local
!.env.example

# vercel
.vercel

# Local docs and security reports — excluded from git and Vercel
/_Do-Not-Upload/

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Merchant-uploaded product photos (local disk)
/public/uploads/**
!/public/uploads/.gitkeep

# Prisma init skill clutter
.agents/
.claude/
.windsurf/
skills-lock.json
AGENTS.md
